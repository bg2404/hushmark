{
  "manifest_version": 3,
  "name": "Hushmark",
  "version": "2.0.0",
  "description": "Private Markdown viewer and editor for files on your computer. Works offline: no network, no analytics, no permissions.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.Md",
        "file:///*.md?*",
        "file:///*.markdown",
        "file:///*.Markdown",
        "file:///*.MARKDOWN",
        "file:///*.markdown?*",
        "file:///*.mdown",
        "file:///*.mkd",
        "file:///*.mkdn",
        "file:///*.mdwn",
        "file:///*.mdtxt",
        "file:///*.mdtext"
      ],
      "js": [
        "vendor/marked.umd.js",
        "vendor/purify.js",
        "vendor/turndown.browser.umd.js",
        "vendor/turndown-plugin-gfm.js",
        "src/render.js",
        "src/prefs.js",
        "src/icons.js",
        "src/markdown-out.js",
        "src/file-access.js",
        "src/editor.js",
        "src/app.js",
        "src/content.js"
      ],
      "css": [
        "src/themes.css",
        "src/content.css",
        "src/editor.css"
      ],
      "run_at": "document_end"
    }
  ]
}
