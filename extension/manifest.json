{
  "manifest_version": 3,
  "name": "Hushmark",
  "version": "2.1.0",
  "description": "Private Markdown viewer and editor for files on your computer and on the web. No analytics, no tracking, no accounts.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Show this tab with Hushmark",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.Md",
        "file:///*.md?*",
        "file:///*.markdown",
        "file:///*.Markdown",
        "file:///*.MARKDOWN",
        "file:///*.markdown?*",
        "file:///*.mdown",
        "file:///*.mkd",
        "file:///*.mkdn",
        "file:///*.mdwn",
        "file:///*.mdtxt",
        "file:///*.mdtext"
      ],
      "js": [
        "vendor/marked.umd.js",
        "vendor/purify.js",
        "vendor/turndown.browser.umd.js",
        "vendor/turndown-plugin-gfm.js",
        "src/render.js",
        "src/prefs.js",
        "src/icons.js",
        "src/config.js",
        "src/markdown-out.js",
        "src/file-access.js",
        "src/editor.js",
        "src/settings.js",
        "src/app.js",
        "src/content.js"
      ],
      "css": [
        "src/themes.css",
        "src/content.css",
        "src/editor.css"
      ],
      "run_at": "document_end"
    }
  ]
}
